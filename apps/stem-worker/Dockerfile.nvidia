FROM python:3.12-slim-trixie AS dependencies
COPY --from=ghcr.io/astral-sh/uv:0.11.28 /uv /uvx /bin/
# Keep parallel CUDA wheel downloads within the build host’s bandwidth.
ENV UV_LINK_MODE=copy \
    UV_CONCURRENT_DOWNLOADS=4 \
    UV_HTTP_CONNECT_TIMEOUT=60 \
    UV_HTTP_TIMEOUT=300

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/apps/stem-worker
# Copy dependency metadata only; local source changes must not reinstall CUDA.
COPY packages/activity-worker-python/pyproject.toml /workspace/packages/activity-worker-python/pyproject.toml
COPY apps/stem-worker/pyproject.toml apps/stem-worker/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv sync --frozen --no-dev --no-install-project --no-install-package partyroom-activity-worker --extra nvidia


FROM python:3.12-slim-trixie

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/apps/stem-worker
COPY --from=dependencies /workspace/apps/stem-worker/.venv ./.venv
COPY packages/activity-worker-python /workspace/packages/activity-worker-python
COPY apps/stem-worker/pyproject.toml apps/stem-worker/uv.lock ./

# Install local code above the reusable third-party environment layer.
RUN --mount=from=dependencies,source=/bin/uv,target=/bin/uv \
    --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv sync --frozen --no-dev --no-install-project --link-mode=copy --extra nvidia
COPY apps/stem-worker/app ./app

ENV PATH="/workspace/apps/stem-worker/.venv/bin:$PATH" \
    HOST=0.0.0.0 \
    PORT=4200 \
    WORK_DIR=/work \
    MODEL_DIR=/models

EXPOSE 4200

CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "4200"]
