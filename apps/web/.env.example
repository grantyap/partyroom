# Public browser-facing URLs for the local Compose stack.
PUBLIC_CONVEX_URL=http://localhost:3210
PUBLIC_CONVEX_SITE_URL=http://localhost:3211

# Optional LAN HTTPS hostname. Install Caddy and set this Mac's Bonjour name first.
# All web dev tasks start HTTPS automatically when set; leave empty for HTTP localhost.
DEV_HTTPS_HOST=

# Webhook tunnels are configured with DEV_WEBHOOK_TUNNEL and SITE_PROXY_PORT
# in the root .env. Stripe and Resend secrets belong in packages/backend/.env.local.
# See .cache/dev-webhooks.json for the complete URLs while the tunnel runs.

# Feedback form.
PUBLIC_FEEDBACK_FORM_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/viewform
