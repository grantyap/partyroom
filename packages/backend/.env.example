# Convex CLI connection settings for the local self-hosted backend.
#
# CONVEX_SELF_HOSTED_ADMIN_KEY is the only value in this file that changes
# after resetting the Convex data volume. With the new backend running, get it
# with:
#   docker compose -f docker-compose.yaml -f docker-compose.dev.yaml \
#     exec -T backend ./generate_admin_key.sh
CONVEX_SELF_HOSTED_URL=http://localhost:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-the-generated-admin-key
CONVEX_URL=http://localhost:3210
CONVEX_SITE_URL=http://127.0.0.1:3211

# Required Convex function settings. Their values stay the same after a reset,
# but must be restored with `bunx convex env set` because Convex stores them in
# the database. The worker origin is Docker-internal; do not use localhost.
SITE_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-a-long-random-development-secret
WORKER_CONVEX_CLOUD_ORIGIN=http://backend:3210

# ACTIVITY_WORKER_TOKEN and WORKER_SIGNING_SECRET intentionally live only in
# the repository-root .env. Compose supplies them to both the backend and the
# workers, so do not duplicate them here.
