# Convex CLI connection settings for the local self-hosted backend.
#
# `bun run dev:setup` replaces CONVEX_SELF_HOSTED_ADMIN_KEY with the current
# backend's key, including after resetting the Convex data volume.
CONVEX_SELF_HOSTED_URL=http://localhost:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-the-generated-admin-key

# Required Convex function settings. Their values stay the same after a reset,
# but must be restored with `bunx convex env set` because Convex stores them in
# the database. The worker origin is Docker-internal; do not use localhost.
SITE_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-a-long-random-development-secret
WORKER_CONVEX_CLOUD_ORIGIN=http://backend:3210

# Configure these before testing billing; never use live keys locally.
# Settings are stored in Convex; rerun bun run dev:setup after changing this file.
# Use a key with customer, subscription, price, coupon, Checkout and portal access.
# Use the Partyroom sandbox destination's signing secret for /stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=price_1UGpFcEDJVsvKYbkV0EQ8sws

# Verification email; partyroom.lol must be verified in Resend.
# Use a sending key restricted to this domain. Disable verification-link click/open tracking.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Partyroom <noreply@partyroom.lol>"
# Signing secret for the Resend destination at /resend/webhook.
RESEND_WEBHOOK_SECRET=
# Set false to test verification with your own inbox; true only allows Resend test addresses.
# Automatic signup emails require a key, sender, and explicitly false test mode.
RESEND_TEST_MODE=true
# After changing these settings, run bun run dev:setup to load them into local Convex.

# ACTIVITY_WORKER_TOKEN and WORKER_SIGNING_SECRET intentionally live only in
# the repository-root .env. Compose supplies them to both the backend and the
# workers, so do not duplicate them here.
