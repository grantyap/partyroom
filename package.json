{
  "name": "partyroom",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "convex": "^1.33.1",
      "better-auth": "1.5.3",
      "@convex-dev/better-auth": "^0.12.2",
      "@mmailaender/convex-svelte": "^0.19.0",
      "@mmailaender/convex-better-auth-svelte": "^0.7.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F @partyroom/backend dev",
    "dev:setup": "turbo -F @partyroom/backend dev:setup",
    "format": "turbo -F web format && turbo -F @partyroom/backend format"
  },
  "dependencies": {
    "@partyroom/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@partyroom/config": "workspace:*",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
