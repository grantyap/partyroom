{
  "name": "partyroom",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6.0.3",
      "convex": "^1.33.1",
      "convex-svelte": "^0.14.0",
      "better-auth": "^1.6.23",
      "@convex-dev/better-auth": "^0.12.5",
      "@convex-dev/presence": "^0.3.2",
      "@mmailaender/convex-better-auth-svelte": "^0.8.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev:docker",
    "dev:build": "turbo run dev:docker:build",
    "dev:mac": "turbo run dev:mac",
    "dev:mac:build": "turbo run dev:mac:build",
    "dev:mac:host": "turbo run dev:mac:host",
    "dev:mac:host:build": "turbo run dev:mac:host:build",
    "dev:nvidia": "turbo run dev:nvidia",
    "dev:nvidia:build": "turbo run dev:nvidia:build",
    "dev:nvidia:host": "turbo run dev:nvidia:host",
    "dev:nvidia:host:build": "turbo run dev:nvidia:host:build",
    "dev:infra": "docker compose -f docker-compose.yaml -f docker-compose.dev.yaml up -d --wait",
    "dev:infra:build": "docker compose -f docker-compose.yaml -f docker-compose.dev.yaml up -d --wait --build",
    "dev:infra:mac": "docker compose -f docker-compose.yaml -f docker-compose.dev.yaml stop stem-worker lyrics-worker && docker compose -f docker-compose.yaml -f docker-compose.dev.yaml -f docker-compose.mac.yaml up -d --wait",
    "dev:infra:mac:build": "docker compose -f docker-compose.yaml -f docker-compose.dev.yaml stop stem-worker lyrics-worker && docker compose -f docker-compose.yaml -f docker-compose.dev.yaml -f docker-compose.mac.yaml up -d --wait --build",
    "dev:infra:nvidia": "docker compose -f docker-compose.yaml -f docker-compose.dev.yaml -f docker-compose.nvidia.yaml up -d --wait",
    "dev:infra:nvidia:build": "docker compose -f docker-compose.yaml -f docker-compose.dev.yaml -f docker-compose.nvidia.yaml up -d --wait --build",
    "dev:down": "docker compose -f docker-compose.yaml -f docker-compose.dev.yaml down",
    "dev:require-mode": "bun scripts/require-dev-mode.ts",
    "dev:require-mode:docker": "bun scripts/require-dev-mode.ts docker",
    "dev:require-mode:mac": "bun scripts/require-dev-mode.ts mac",
    "dev:require-mode:nvidia": "bun scripts/require-dev-mode.ts nvidia",
    "dev:reset": "docker compose -f docker-compose.yaml -f docker-compose.dev.yaml down --volumes",
    "generate:activities": "bun scripts/generate-activity-contracts.ts",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F @partyroom/backend dev",
    "dev:setup": "turbo -F @partyroom/backend dev:setup",
    "format": "turbo -F web format && turbo -F @partyroom/backend format"
  },
  "dependencies": {
    "@partyroom/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@partyroom/config": "workspace:*",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
