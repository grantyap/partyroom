{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".svelte-kit/**", "build/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#dev:require-mode:docker": {
      "cache": false
    },
    "//#dev:require-mode:mac": {
      "cache": false
    },
    "//#dev:require-mode:nvidia": {
      "cache": false
    },
    "//#dev:infra": {
      "cache": false,
      "dependsOn": ["//#dev:require-mode:docker"]
    },
    "//#dev:infra:build": {
      "cache": false,
      "dependsOn": ["//#dev:require-mode:docker"]
    },
    "//#dev:infra:mac": {
      "cache": false,
      "dependsOn": ["//#dev:require-mode:mac"]
    },
    "//#dev:infra:mac:build": {
      "cache": false,
      "dependsOn": ["//#dev:require-mode:mac"]
    },
    "//#dev:infra:nvidia": {
      "cache": false,
      "dependsOn": ["//#dev:require-mode:nvidia"]
    },
    "//#dev:infra:nvidia:build": {
      "cache": false,
      "dependsOn": ["//#dev:require-mode:nvidia"]
    },
    "dev:docker": {
      "cache": false,
      "dependsOn": ["//#dev:infra"],
      "persistent": true
    },
    "dev:docker:build": {
      "cache": false,
      "dependsOn": ["//#dev:infra:build"],
      "persistent": true
    },
    "dev:mac": {
      "cache": false,
      "dependsOn": ["//#dev:infra:mac"],
      "persistent": true
    },
    "dev:mac:build": {
      "cache": false,
      "dependsOn": ["//#dev:infra:mac:build"],
      "persistent": true
    },
    "dev:mac:host": {
      "cache": false,
      "dependsOn": ["//#dev:infra:mac"],
      "persistent": true
    },
    "dev:mac:host:build": {
      "cache": false,
      "dependsOn": ["//#dev:infra:mac:build"],
      "persistent": true
    },
    "dev:nvidia": {
      "cache": false,
      "dependsOn": ["//#dev:infra:nvidia"],
      "persistent": true
    },
    "dev:nvidia:build": {
      "cache": false,
      "dependsOn": ["//#dev:infra:nvidia:build"],
      "persistent": true
    },
    "dev:nvidia:host": {
      "cache": false,
      "dependsOn": ["//#dev:infra:nvidia"],
      "persistent": true
    },
    "dev:nvidia:host:build": {
      "cache": false,
      "dependsOn": ["//#dev:infra:nvidia:build"],
      "persistent": true
    },
    "dev:setup": {
      "cache": false,
      "persistent": true
    }
  }
}
