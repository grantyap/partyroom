# Required by Docker Compose. Coolify surfaces every value in this section and
# blocks deployment until it is set. Generate different secret values once for
# each environment (for example, with `openssl rand -hex 32`) and never commit them.
#
# These values are shared by the Convex backend and activity workers. They do
# not change when the local Convex database is reset.
WORKER_SIGNING_SECRET=replace-with-a-long-random-development-secret
ACTIVITY_WORKER_TOKEN=replace-with-a-different-long-random-development-secret
BETTER_AUTH_SECRET=replace-with-another-long-random-development-secret

# Public service URLs. PUBLIC_* values are baked into the browser bundle at build time.
PUBLIC_CONVEX_URL=https://convex.example.com
PUBLIC_CONVEX_SITE_URL=https://convex-site.example.com
PUBLIC_FEEDBACK_FORM_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/viewform
CONVEX_CLOUD_ORIGIN=https://convex.example.com
CONVEX_SITE_ORIGIN=https://convex-site.example.com
NEXT_PUBLIC_DEPLOYMENT_URL=https://convex.example.com
# Embedded in the web build as SvelteKit paths.origin; rebuild web after changing it.
ORIGIN=https://partyroom.example.com

# Development only: optional stable LAN hostname for Caddy HTTPS (for example pmm.local).
# Leave empty for regular localhost development. Never set this for production.
DEV_HTTPS_HOST=

# Development only: start a temporary public webhook tunnel with any dev:* command.
# Requires cloudflared; the tunnel stops with the development process.
# Complete URLs are printed and saved to .cache/dev-webhooks.json while running.
DEV_WEBHOOK_TUNNEL=false
# Local Convex HTTP port used by Compose and the webhook tunnel.
SITE_PROXY_PORT=3211

# Early-access waitlist and access-code gate.
GOOGLE_FORM_ACTION_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/formResponse
GOOGLE_FORM_NAME_FIELD=entry.000000000
GOOGLE_FORM_EMAIL_FIELD=entry.111111111
GOOGLE_SHEETS_ACCESS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_SHEETS_ACCESS_SECRET=replace-with-a-long-random-secret

# Stem separation tuning. Mac mode uses MLX; Docker/NVIDIA use audio-separator.
STEM_MDX_OVERLAP=0.1
STEM_WRITE_WORKERS=2

# LRCLIB fallback metadata extraction (Qwen3 1.7B). Plain Docker uses CPU;
# dev:mac requires native Ollama/Metal, dev:nvidia requires CUDA.
METADATA_WORKER_CPU_LIMIT=2.0
METADATA_WORKER_MEMORY_LIMIT=2g
