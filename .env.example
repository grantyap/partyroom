# Required by Docker Compose. Generate two different values once for each
# environment (for example, with `openssl rand -hex 32`) and never commit them.
#
# These values are shared by the Convex backend and activity workers. They do
# not change when the local Convex database is reset.
WORKER_SIGNING_SECRET=replace-with-a-long-random-development-secret
ACTIVITY_WORKER_TOKEN=replace-with-a-different-long-random-development-secret
